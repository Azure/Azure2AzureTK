// Get list of ANF volumes for fill level analysis

resources
| where type == 'microsoft.netapp/netappaccounts/capacitypools/volumes'
and subscriptionId in (
    'f2f41868-3738-44d9-9067-9b5d361f4058',
    '95fce658-ff31-47e8-8c0c-8e29022f5024',
    '73578047-33a3-4bd0-9eaa-3f465a38982e',
    '52e61b21-5d26-4612-adca-414a402cdef2',
    '959386c8-352b-42a9-8797-b0d4b24861a2',
    '3af3b1d7-1863-4cdb-b69c-38fd1179119c',
    'bb59e5fd-2bac-451a-92b0-0d3e70612a56')
| project name, id, size=properties.usageThreshold, tier=properties.serviceLevel
| order by name